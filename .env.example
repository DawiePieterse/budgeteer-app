APP_NAME=Budgeteer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=budgeteer
DB_USERNAME=budgeteer
DB_PASSWORD=budgeteer

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="budget@bowlsbuddy.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Google sign-in (https://console.cloud.google.com, OAuth client "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Comma-separated Google email addresses allowed to sign in, and the household they join.
# Used by `php artisan budgeteer:setup` to create the household on a new install.
BUDGETEER_HOUSEHOLD_NAME="My household"
BUDGETEER_ALLOWED_EMAILS=

# Development only: shows "Sign in as" buttons on the sign-in page. Never on in production.
BUDGETEER_DEV_LOGIN=false

# Phone notifications. `php artisan budgeteer:push-keys` fills these in.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
